# ==========================================
# MangaBook V2 - Example environment file
# ==========================================
# Copy this file to ".env" for local development.
# Never commit your real ".env" file.

# Flask
FLASK_ENV=development
FLASK_DEBUG=0

# Security
# Required outside tests.
# Replace this value in your local ".env".
SECRET_KEY=change-me-in-local-env

# Database
DATABASE=instance/manga.sqlite

# Uploads
MAX_CONTENT_LENGTH=2097152

# Free demo deployment
# Set to 1 only for temporary demo hosting with an ephemeral SQLite database.
AUTO_SEED_DEMO=0

# Tests
TESTING=0
